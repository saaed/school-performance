<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>SchoolPerformance.DbReport</RootNamespace>
    <AssemblyName>SchoolPerformance.DbReport</AssemblyName>
  </PropertyGroup>

  <!--
    The query shapes live in ../QueryShapes, shared with data-volume, so there is exactly
    ONE copy of the application's SQL. This project renders the report; it does not own the
    shapes it measures.
  -->
  <ItemGroup>
    <ProjectReference Include="..\QueryShapes\QueryShapes.csproj" />
  </ItemGroup>

  <!-- Same package set as ../data-volume, so the two projects cannot drift apart. -->
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
  </ItemGroup>

  <!--
    The connection string is deliberately NOT duplicated in this folder: this links the
    file the data-volume project already copies, so exactly one file in the repo holds the
    perf-database credentials. SCUBE_PERF_DB overrides it at runtime.
  -->
  <ItemGroup>
    <None Include="..\data-volume\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
